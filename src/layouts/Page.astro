---
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · Ancient Ice</title>
  </head>
  <body>
    <header><a href="/" aria-label="Ancient Ice 博客首页"><i aria-hidden="true">❄</i> Ancient Ice</a></header>
    <main><slot /></main>
  </body>
</html>
<style is:global>
  :root { color-scheme: light; --ink:#173c3b; --leaf:#246959; --line:#c7d7cd; }
  * { box-sizing:border-box; }
  body { margin:0; color:var(--ink); background:#fafaf5; font:17px/1.85 "Source Sans 3",system-ui,sans-serif; }
  header { border-bottom:1px solid var(--line); padding:16px max(6vw,calc((100vw - 1020px)/2)); }
  header a { display:inline-flex; gap:12px; align-items:center; font: bold 26px Georgia,serif; white-space:nowrap; text-decoration:none; }
  header i { display:grid; place-items:center; background:var(--ink); border-radius:50%; width:38px; height:38px; color:#e7f0dd; font-style:normal; }
  main { max-width:910px; margin:clamp(36px,7vw,85px) auto; padding:0 24px; }
  h1,h2,h3 { font-family:Georgia,"Songti SC","Noto Serif CJK SC",serif; line-height:1.4; text-wrap:balance; }
  h1 { font-size:clamp(34px,6vw,60px); letter-spacing:-.04em; margin:15px 0 22px; }
  a { color:var(--leaf); text-underline-offset:4px; }
  a:hover { color:#102e2d; }
  time,.meta { color:#536a62; font-size:.88rem; }
  .tags { display:flex; gap:10px; flex-wrap:wrap; }
  .tags a { background:#e7eee3; border-radius:3px; padding:2px 9px; font-size:.85rem; text-decoration:none; }
  .entry { padding:26px 0; border-top:1px solid var(--line); }
  .entry h2 { margin:8px 0; }
  .entry h2 a { color:var(--ink); text-decoration:none; }
  .entry h2 a:hover { text-decoration:underline; }
  article { max-width:740px; margin:auto; overflow-wrap:anywhere; }
  article h1 { font-size:clamp(30px,5vw,47px); }
  .body { margin-top:32px; border-top:1px solid var(--line); padding-top:12px; }
  .body h2 { margin:1.8em 0 .6em; }
  .body pre,.body blockquote { margin:1em 0; padding:14px 20px; border-radius:4px; }
  .body pre { overflow:auto; }
  .body blockquote { background:#e9efe5; border-left:3px solid var(--leaf); }
  blockquote p { margin:0; }
  .body table { display:block; overflow:auto; border-collapse:collapse; font-size:.94em; }
  th,td { text-align:left; vertical-align:top; border-bottom:1px solid var(--line); padding:10px; }
  img { max-width:100%; height:auto; }
</style>
